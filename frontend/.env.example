# Vite exposes only vars prefixed with VITE_ to the browser.
# Set to your backend API base URL (must include /api suffix).
# Local dev default backend URL:
VITE_API_BASE_URL=http://localhost:5000/api

# Canonical backend reference-data routes used by frontend service layer:
# /api/reference-data/locations
# /api/reference-data/goods
# /api/reference-data/stocks?locationId=
